    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <uxap:ObjectPageLayout showEditHeaderButton="true" editHeaderButtonPress=".handleEditBtnPress" headerContentPinned="true">
    <uxap:headerTitle>
