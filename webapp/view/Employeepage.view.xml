				</uxap:snappedHeading>

				<uxap:expandedContent>
					<Text text="SAP FICO"/>
				</uxap:expandedContent>

				<uxap:snappedContent>
					<Text text="SAP FICO "/>
				</uxap:snappedContent>

				<uxap:snappedTitleOnMobile>
					<Title text="SAP FICO"/>
				</uxap:snappedTitleOnMobile>
                
        </uxap:ObjectPageDynamicHeaderTitle>

        <uxap:actions>
            
        <Button icon="sap-icon://edit"type="Emphasized"</Button>
        
            </uxap:actions>

